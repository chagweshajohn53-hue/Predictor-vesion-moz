# Provider API keys are stored and managed in the in-app Client Vault (localStorage + /api/vault/sync).
# No hardcoded server secrets are required.
# GEMINI_API_KEY is only used as an optional runtime fallback when no Gemini key is added to the Vault.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

