# GEMINI_API_KEY: Required for built-in Gemini 4 Hydrogen swarm & grounding.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Specialist Picture Extractor & Final Reviewer (Claude Haiku 5.5)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"

# Optional Free-Tier Failover Chain Keys (comma-separated for backup key pooling)
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Optional Custom Upstream Proxy & External /v1 OpenAI-Compatible Token
PREDICTOR_PROXY_URL=""
PREDICTOR_PROXY_KEY=""
PREDICTOR_PROXY_MODEL=""
FREEFLOW_API_TOKEN=""
